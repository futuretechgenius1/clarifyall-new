# ClarifyAll Environment Configuration Example
# Do not commit real secrets to source control.

PORT=3000
NODE_ENV=development

# Database configuration (Hostinger MySQL 8)
DB_HOST=srv1148.hstgr.io
DB_PORT=3306
DB_NAME=u530425252_clarifyall
DB_USER=u530425252_clarifyall
DB_PASSWORD=your_database_password_here
DATABASE_URL="mysql://u530425252_clarifyall:your_database_password_here@srv1148.hstgr.io:3306/u530425252_clarifyall"

# AI Provider Configuration
# Supported providers: gemini (built-in @google/genai SDK), groq
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Admin Security & Auth
ADMIN_BOOTSTRAP_KEY=clarifyall_secure_admin_key_2026
JWT_SECRET=super_secret_jwt_key_at_least_32_characters

# Application URL for canonical SEO links and OpenGraph
APP_URL=https://clarifyall.com

# Analytics & Ads (Disabled by default)
ENABLE_ADS=false
GOOGLE_ADSENSE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_VERIFICATION=
